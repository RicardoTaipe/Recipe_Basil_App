<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Recipe_Basil_App" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/bottle_green</item>
        <item name="colorOnPrimary">@color/bottle_green</item>
        <item name="colorOnTertiary">@color/red_orange</item>
        <item name="colorPrimaryDark">@color/green_cyan</item>
        <item name="colorPrimaryVariant">@color/turquoise_green</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/red_orange</item>
        <item name="colorSecondaryVariant">@color/cosmic_latte</item>
        <item name="colorOnSecondary">@color/bottle_green</item>

        <item name="colorSurface">@color/cosmic_latte</item>
        <item name="colorOnSurface">@color/bottle_green</item>

        <item name="android:colorBackground">@color/cosmic_latte</item>
        <item name="colorOnBackground">@color/bottle_green</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/egg_shell</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Fonts-->
        <item name="android:fontFamily">@font/montserrat_regular</item>

        <item name="textAppearanceDisplayLarge">@style/TextAppearance.Recipe.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.Recipe.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Recipe.DisplayLarge</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.Recipe.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Recipe.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Recipe.HeadlineSmall</item>

        <item name="textAppearanceTitleLarge">@style/TextAppearance.Recipe.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Recipe.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.Recipe.TitleSmall</item>

        <item name="textAppearanceBodyLarge">@style/TextAppearance.Recipe.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Recipe.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.Recipe.BodyMedium</item>

        <item name="textAppearanceLabelLarge">@style/TextAppearance.Recipe.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Recipe.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.Recipe.LabelSmall</item>
    </style>

    <style name="TextAppearance.Recipe.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:textSize">96sp</item>
    </style>

    <style name="TextAppearance.Recipe.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:textSize">60sp</item>
    </style>

    <style name="TextAppearance.Recipe.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:textSize">48sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Recipe.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:textSize">34sp</item>
    </style>

    <style name="TextAppearance.Recipe.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/montserrat_medium</item>
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:textSize">24sp</item>
    </style>

    <style name="TextAppearance.Recipe.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/lekton_bold</item>
        <item name="android:textSize">21sp</item>
    </style>

    <style name="TextAppearance.Recipe.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/lekton_bold</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="TextAppearance.Recipe.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/lekton_bold</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.Recipe.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/montserrat_semibold</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TextAppearance.Recipe.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/montserrat_regular</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TextAppearance.Recipe.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.Recipe.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.Recipe.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/montserrat_regular</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">10sp</item>
    </style>
</resources>

